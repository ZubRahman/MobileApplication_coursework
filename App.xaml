<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.App">
    <Application.Resources>
        <ResourceDictionary>

            <Color x:Key="PrimaryPurple">#6750A4</Color>
            <Color x:Key="PrimaryPurpleDark">#4F378B</Color>
            <Color x:Key="BackgroundLight">White</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#1C1B1F</Color>
            <Color x:Key="TextSecondary">#6B7280</Color>

            <Style x:Key="PageTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="BodyLabelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="MutedLabelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            </Style>

            <Style x:Key="CardFrameStyle" TargetType="Frame">
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,4,0,8" />
                <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                <Setter Property="BorderColor" Value="#E5E7EB" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HasShadow" Value="False" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryPurple}" />
                <Setter Property="TextColor" Value="White" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
