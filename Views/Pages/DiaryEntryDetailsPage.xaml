<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.Views.Pages.DiaryEntryDetailsPage"
             Title="Diary Entry">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Image Source="{Binding CoverUrl}"
                   HeightRequest="220"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <Label Text="{Binding GameTitle}"
                   FontSize="24"
                   FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="16">
                <Label Text="{Binding Rating, StringFormat='Rating: {0}/10'}"
                       FontSize="15" />
                <Label Text="{Binding PlayedOn, StringFormat='Date: {0:dd MMM yyyy}'}"
                       FontSize="15" />
            </HorizontalStackLayout>

            <Label Text="Full Review"
                   FontAttributes="Bold"
                   FontSize="16" />

            <Frame Padding="12">
                <Label Text="{Binding Review}"
                       LineBreakMode="WordWrap"
                       FontSize="14" />
            </Frame>

            <Button Text="Edit"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding EditCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>