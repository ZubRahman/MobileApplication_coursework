<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.Views.Pages.EditRatingPage"
             Title="Rate Game">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding GameTitle}" FontSize="22" FontAttributes="Bold"/>

            <Label Text="Rating (1–10)" />
            <Slider Minimum="1" Maximum="10" Value="{Binding Rating}" />
            <Label Text="{Binding Rating, StringFormat='Rating: {0:F0}/10'}" />

            <Label Text="Review" />
            <Editor AutoSize="TextChanges"
                    HeightRequest="140"
                    Text="{Binding Review}"
                    Placeholder="What did you think?" />

            <Button Text="Save" Command="{Binding SaveCommand}" />
            <Button Text="Delete"
        Command="{Binding DeleteCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>