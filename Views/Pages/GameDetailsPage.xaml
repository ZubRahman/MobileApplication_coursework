<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.Views.Pages.GameDetailsPage"
             Title="Game Details">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="{Binding GameTitle}" FontSize="24" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="12">
                <Label Text="{Binding GamePlatform}" FontSize="14" />
                <Label Text="•" FontSize="14" />
                <Label Text="{Binding GameGenre}" FontSize="14" />
            </HorizontalStackLayout>
            <Label Text="{Binding GameSummary}" FontSize="14" />
            <Button Text="Rate / Review" Command="{Binding OpenRateCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>