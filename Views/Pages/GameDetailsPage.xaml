<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.Views.Pages.GameDetailsPage"
             Title="Game Details">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Image Source="{Binding GameCoverUrl}"
                   HeightRequest="260"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <Label Text="{Binding GameTitle}"
                   FontSize="28"
                   FontAttributes="Bold" />

            <Label Text="{Binding GamePlatform}"
                   FontSize="14"
                   Opacity="0.8" />

            <Label Text="{Binding GameGenre}"
                   FontSize="14"
                   Opacity="0.8" />

            <Label Text="{Binding GameSummary}"
                   FontSize="14" />

            <Button Text="Rate / Review"
            Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding OpenRateCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>