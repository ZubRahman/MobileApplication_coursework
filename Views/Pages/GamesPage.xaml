<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.Views.Pages.GamesPage"
             Title="Discover">

    <Grid Padding="10" RowDefinitions="Auto,*" RowSpacing="10">

        <SearchBar Grid.Row="0"
                   Placeholder="Search games..."
                   Text="{Binding SearchText}" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Games}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="0,4,0,8">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnGameTapped"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <Grid ColumnDefinitions="90,*" ColumnSpacing="12">

                            <Image Grid.Column="0"
                                   Source="{Binding CoverUrl}"
                                   HeightRequest="120"
                                   WidthRequest="90"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="4">
                                <Label Text="{Binding Title}"
                                       FontSize="18"
                                       FontAttributes="Bold" />

                                <Label Text="{Binding Platform}"
                                       FontSize="12"
                                       Opacity="0.8" />
                            </VerticalStackLayout>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>