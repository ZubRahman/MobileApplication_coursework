<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.Views.Pages.ProfilePage"
             Title="Profile">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Profile" FontSize="24" FontAttributes="Bold" />

            <Label Text="Auth Status" FontAttributes="Bold" />
            <Label Text="{Binding AuthStatus}" />

            <Label Text="Email" FontAttributes="Bold" />
            <Label Text="{Binding UserEmail}" />

            <Label Text="Total Logs" FontAttributes="Bold" />
            <Label Text="{Binding TotalLogs}" />

            <Label Text="Average Rating" FontAttributes="Bold" />
            <Label Text="{Binding AverageRating, StringFormat='{}{0:F1}'}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>