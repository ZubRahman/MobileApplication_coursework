<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.Views.Pages.ProfilePage"
             Title="Profile">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Label Text="Profile"
                   FontSize="26"
                   FontAttributes="Bold" />

            <Frame Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Account"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <Label Text="Status"
                           FontAttributes="Bold"
                           FontSize="13" />
                    <Label Text="{Binding AuthStatus}"
                           FontSize="14" />

                    <Label Text="Email"
                           FontAttributes="Bold"
                           FontSize="13" />
                    <Label Text="{Binding UserEmail}"
                           FontSize="14" />

                    <Button Text="Log In"
                    Command="{Binding OpenLoginCommand}"
                    IsVisible="{Binding IsLoggedOut}" />

                    <Button Text="Sign Up"
                    Command="{Binding OpenSignUpCommand}"
                    IsVisible="{Binding IsLoggedOut}" />

                    <Button Text="Log Out"
                            Command="{Binding LogOutCommand}"
                            IsVisible="{Binding IsLoggedIn}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Sync"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <Button Text="Sync Now"
                            Command="{Binding SyncNowCommand}" />

                    <Label Text="{Binding SyncStatusMessage}"
                           FontSize="13"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="14">
              <VerticalStackLayout Spacing="10">
                     <Label Text="Stats"
                            FontSize="18"
                            FontAttributes="Bold" />

                     <Label Text="Diary Logs"
                            FontAttributes="Bold"
                            FontSize="13" />
                     <Label Text="{Binding TotalLogs}"
                            FontSize="14" />

                     <Label Text="Average Rating"
                            FontAttributes="Bold"
                            FontSize="13" />
                     <Label Text="{Binding AverageRating, StringFormat='{}{0:F1}/10'}"
                            FontSize="14" />

                     <Label Text="Highest Rated Game"
                            FontAttributes="Bold"
                            FontSize="13" />
                     <Label Text="{Binding HighestRatedGame}"
                            FontSize="14" />

                     <Label Text="Most Logged Game"
                            FontAttributes="Bold"
                            FontSize="13" />
                     <Label Text="{Binding MostLoggedGame}"
                            FontSize="14" />
              </VerticalStackLayout>
             </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>